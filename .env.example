# Bind address and port
HOST=127.0.0.1
PORT=8787

# First-run administrator (only used when the database is empty)
KESTREL_ADMIN_EMAIL=admin@kestrel.local
KESTREL_ADMIN_PASSWORD=change-this-to-a-long-password

# Optional data directory (defaults to ./data)
# KESTREL_DATA_DIR=C:\kestrel-data

# Concurrency and timeouts
KESTREL_SCAN_CONCURRENCY=2
KESTREL_ENGINE_TIMEOUT_MS=120000
KESTREL_LLM_TIMEOUT_MS=90000

# Reverse proxy trust (Express "trust proxy"): false, true, hop count, or a
# value such as "loopback". Leave false unless a proxy sets X-Forwarded-For.
KESTREL_TRUST_PROXY=false

# Rate limits
KESTREL_API_RATE_WINDOW_MS=60000
KESTREL_API_RATE_MAX=600
KESTREL_LOGIN_RATE_WINDOW_MS=900000
KESTREL_LOGIN_IP_MAX=60
KESTREL_LOGIN_ACCOUNT_MAX=10

# Queue and retention
KESTREL_JOB_MAX_ATTEMPTS=3
KESTREL_JOB_RETRY_DELAY_MS=5000
KESTREL_JOB_RETENTION_DAYS=14
KESTREL_AUDIT_RETENTION_DAYS=180

# Python binary for the Python analyzer and fuzzer
KESTREL_PYTHON=python
